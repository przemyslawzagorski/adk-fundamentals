# =============================================================================
# Module 23 — ADK + Auggie SDK Integration
# =============================================================================
# Skopiuj do .env i uzupełnij. Plik .env w katalogu nadrzędnym (adk_training/.env)
# też jest ładowany jako fallback.
# =============================================================================

# --- Google ADK (Gemini jako "tani dispatcher") ---
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Auggie SDK (Claude jako "drogi specjalista od kodu") ---
# Opcja A: pełna sesja (zalecane dla service accounts)
# AUGMENT_SESSION_AUTH={"accessToken":"...","tenantURL":"https://e1-eu.api.augmentcode.com/","scopes":["read","write"]}

# Opcja B: osobne pola
AUGMENT_API_KEY=your-augment-api-token
AUGMENT_API_URL=https://e1-eu.api.augmentcode.com/

# Model używany przez wszystkie tools (sonnet4.5 | sonnet4 | haiku4.5 | gpt5)
AUGGIE_MODEL=sonnet4.5

# --- Ustawienia produkcyjne (opcjonalne) ---
# Domyślny timeout w sekundach (default 180)
AUGGIE_TIMEOUT=180

# Maksymalna liczba tur agenta Auggie (kontrola kosztów)
AUGGIE_MAX_TURNS=10

# Workspace dla Auggie (domyślnie = katalog modułu 23)
# AUGGIE_WORKSPACE=C:\path\to\your\repo

# Włącz telemetrię (loguje wywołania, czasy, koszty)
AUGGIE_TELEMETRY=true
